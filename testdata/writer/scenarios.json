 "sessions": {
  "description": "Concurrent sessions on one branch: conflicts without rebase, rebases of disjoint changes (chunks, new and deleted nodes), and rebases that must fail (same chunk, chunks of an array whose metadata changed, chunks of a deleted array, metadata of a deleted group).",
  "steps": [
   {"op": "open", "session": "base", "branch": "main"},
   {"op": "create_group", "session": "base", "path": "/"},
   {"op": "create_group", "session": "base", "path": "/grp", "attributes": {"k": 1}},
   {"op": "create_array", "session": "base", "path": "/x", "spec": {"shape": [8], "chunks": [2], "data_type": "int32", "fill_value": 0, "codecs": [{"name": "bytes", "configuration": {"endian": "little"}}]}},

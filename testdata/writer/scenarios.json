   {"op": "write", "session": "base", "path": "/x", "start": [0], "shape": [8], "seed": 1},
   {"op": "write", "session": "base", "path": "/y", "start": [0], "shape": [8], "seed": 2},
   {"op": "commit", "session": "base", "message": "base"},
   {"op": "open", "session": "A", "branch": "main"},
